# Copy to deploy/.env and fill in. Never commit deploy/.env.

# The address staff will open, e.g. staging.example.co.ke. Its DNS A record must
# point at this server before the first start, so Caddy can get an HTTPS certificate.
DOMAIN=localhost

# Generate each secret with:  openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# production turns off the development logins (director@gmail.com and the others).
ENVIRONMENT=production

# Daily backup time (Nairobi time) and how many days of backups to keep.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# Off-site copy: an rclone remote and folder, e.g. b2:biashara-backups or gdrive:biashara-backups.
# Set it up with `rclone config` and copy rclone.conf into deploy/rclone/ (see DEPLOYMENT.md).
BACKUP_REMOTE=

# Optional error reports: a Sentry project DSN. Leave empty to turn off.
SENTRY_DSN=
